{
  "manifest_version": 3,
  "name": "youtube step sequencer",
  "version": "1.0.0",
  "description": "secuencia rítmica de saltos por teclado para videos de youtube.",
  "icons": {
    "16": "icons/mpc-16.png",
    "32": "icons/mpc-32.png",
    "48": "icons/mpc-48.png",
    "128": "icons/mpc-128.png"
  },
  "permissions": ["activeTab", "storage", "system.display"],
  "action": {
    "default_title": "youtube step sequencer",
    "default_icon": {
      "16": "icons/mpc-16.png",
      "32": "icons/mpc-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://youtube.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
